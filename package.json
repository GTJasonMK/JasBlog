{
  "name": "jasblog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "node node_modules/@jas/site-tools/dist/cli.js prepare",
    "postbuild": "node node_modules/@jas/site-tools/dist/cli.js finalize && pagefind --site out",
    "start": "npx serve@latest out",
    "test": "tsx --test scripts/*.test.ts",
    "lint": "eslint src scripts next.config.ts postcss.config.mjs --ext .js,.jsx,.ts,.tsx,.mjs",
    "commit:content": "node node_modules/@jas/site-tools/dist/cli.js publish",
    "photo:add": "tsx scripts/import-photo.ts",
    "site:migrate": "tsx scripts/migrate-site.ts"
  },
  "dependencies": {
    "@jas/content-core": "https://github.com/GTJasonMK/JasShared/releases/download/content-core-v0.7.0/jas-content-core-0.7.0.tgz",
    "@jas/content-ui": "https://github.com/GTJasonMK/JasShared/releases/download/content-ui-v0.7.0/jas-content-ui-0.7.0.tgz",
    "@jas/site-tools": "https://github.com/GTJasonMK/JasShared/releases/download/site-tools-v0.7.0/jas-site-tools-0.7.0.tgz",
    "@jas/graph-core": "https://github.com/GTJasonMK/JasShared/releases/download/graph-core-v0.2.0/jas-graph-core-0.2.0.tgz",
    "@jas/graph-ui": "https://github.com/GTJasonMK/JasShared/releases/download/graph-ui-v0.3.0/jas-graph-ui-0.3.0.tgz",
    "@giscus/react": "^3.1.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@xyflow/react": "^12.10.0",
    "agentation": "^1.3.2",
    "next": "^16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.1.7",
    "pagefind": "^1.4.0",
    "postcss": "^8",
    "tailwindcss": "^4",
    "tsx": "^4.23.9",
    "typescript": "^5"
  }
}
